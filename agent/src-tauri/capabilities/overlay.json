{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Overlay window: receives notes and reports its size. No network access at all.",
  "windows": ["overlay"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-overlay-ready",
    "allow-overlay-layout"
  ]
}
