# TLS certificates come from TLS-ALPN-01 on port 443, so port 80 stays closed.
{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

(security) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
	# Access logs without query strings or headers (tokens never travel in URLs anyway).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete *
				}
				request>headers delete
				resp_headers delete
			}
		}
	}
}

app.{$KHJ_DOMAIN} {
	import security
	encode zstd gzip

	# Desktop agent installer and signed updates (PLAN-PHASE2 §2.8). The manifest is public; its
	# integrity comes from the minisign signature checked by the agent, not from this host.
	handle_path /agent/* {
		root * /srv/agent
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		file_server
	}

	@backend path /api/* /hooks/*
	handle @backend {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; media-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types khj"
		@immutable path /assets/* /shared/fonts/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@revalidate path / /index.html /sw.js /manifest.webmanifest /shared/tokens.css
		header @revalidate Cache-Control "no-cache"
		root * /srv/cashier
		try_files {path} /index.html
		file_server
	}
}

admin.{$KHJ_DOMAIN} {
	import security
	encode zstd gzip
	reverse_proxy api:8000
}

# Exists so Caddy obtains (and renews) the certificate the SMTP server uses for STARTTLS.
in.{$KHJ_DOMAIN} {
	respond 404
}
